# ============================================================
# undangan-os Environment Variables
# Copy this to .env and fill in the values
# NEVER commit .env to git
# ============================================================

# Application
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=undangan-os

# Database (PostgreSQL)
DATABASE_URL=postgresql://undangan:undangan_dev_secret@localhost:5432/undangan_dev

# Redis
REDIS_URL=redis://localhost:6379

# Storage (MinIO / S3-compatible)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=undangan_minio
STORAGE_SECRET_KEY=undangan_minio_secret
STORAGE_BUCKET=undangan
STORAGE_REGION=us-east-1
STORAGE_PUBLIC_URL=http://localhost:9000/undangan

# Auth (Better Auth)
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=CHANGE_ME_IN_PRODUCTION

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email (SMTP)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@localhost

# AI (optional, for M7)
ANTHROPIC_API_KEY=
FAL_API_KEY=

# WhatsApp (optional, for M6)
WA_CLOUD_API_TOKEN=
WA_PHONE_NUMBER_ID=
WA_BUSINESS_ACCOUNT_ID=

# Analytics (optional)
OTEL_EXPORTER_OTLP_ENDPOINT=

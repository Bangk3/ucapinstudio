# ============================================================
# Invyte — Environment Variables
# Copy to .env and fill in the values
# NEVER commit .env to git
# ============================================================

# Application
NODE_ENV=development
APP_URL=http://localhost:3000
APP_DOMAIN=localhost

# Database (PostgreSQL)
POSTGRES_USER=invyte
POSTGRES_PASSWORD=invyte_dev_secret
POSTGRES_DB=invyte_dev
DATABASE_URL=postgresql://invyte:invyte_dev_secret@localhost:5432/invyte_dev

# Redis
REDIS_URL=redis://localhost:6379

# Storage (MinIO / S3-compatible)
STORAGE_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=invyte_minio
MINIO_ROOT_PASSWORD=invyte_minio_secret
STORAGE_BUCKET=invyte
STORAGE_REGION=us-east-1
STORAGE_PUBLIC_URL=http://localhost:9000/invyte

# Auth (Better Auth)
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=CHANGE_ME_IN_PRODUCTION

# Guest phone hashing salt (for dedup detection across same-name guests)
# Combined with tenantId + normalized E.164 phone → SHA-256 hex hash.
# Stored in guests.phone_hash; plaintext phone stays in guests.phone.
# MUST be ≥16 chars. Generate with: openssl rand -base64 32
GUEST_PHONE_HASH_SALT=CHANGE_ME_IN_PRODUCTION

# AES-256-GCM key for encrypting messaging_credentials (WA/SMS provider
# tokens at rest). MUST be exactly 64 hex chars (32 bytes).
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=CHANGE_ME_IN_PRODUCTION

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email (SMTP)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@localhost

# AI (optional, for Phase 2)
# Only the key for the model the user picks in the AI composer is required.
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_MODEL=z-ai/glm4.7
FAL_API_KEY=

# WhatsApp (optional, for Phase 2). Also used as UcapinStudio's own shared
# provider for guest broadcasts on staff-created "WA order" tenants — see
# docs/superpowers/specs/2026-08-08-wa-order-pricing-settings-design.md.
WA_CLOUD_API_TOKEN=
WA_PHONE_NUMBER_ID=
WA_BUSINESS_ACCOUNT_ID=

# MinIO Console (production only — set to separate subdomain)
# MINIO_CONSOLE_DOMAIN=minio.example.com
# MINIO_CONSOLE_URL=https://minio.example.com

# Analytics (optional)
OTEL_EXPORTER_OTLP_ENDPOINT=
